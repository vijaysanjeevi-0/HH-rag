# ===== Dependencies =====
# Installed packages — reproducible from package.json, never commit
node_modules/

# ===== Build output =====
# Generated by `npm run build`, rebuilt anytime
dist/

# ===== Environment / secrets =====
# Contains VITE_API_ENDPOINT and any API keys — never commit these
.env
.env.local
.env.*.local

# ===== Logs =====
# Dev server output and debug logs
dev.log
*.log
npm-debug.log*

# ===== Editor / OS noise =====
.vscode/
.idea/
.DS_Store
Thumbs.db
